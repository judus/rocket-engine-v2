  {
    "name": "create_fact_condition",
    "description": "Create a typed current-fact condition from a granted inspection. Return condition ID; use comparison.path for nested output.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "draft": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
