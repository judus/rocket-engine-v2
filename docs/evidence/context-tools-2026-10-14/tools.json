            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["id", "revision"],
          "additionalProperties": false
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "arguments": {
          "type": "object"
        },
        "comparison": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "operator": {
                  "enum": ["equals", "at_least"]
                },
                "value": {
                  "type": ["string", "number", "boolean", "null"]
                }
              },
              "required": ["field", "operator", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "minItems": 1,
                  "maxItems": 8
                },
                "operator": {
                  "enum": ["equals", "at_least"]
                },
                "value": {
                  "type": ["string", "number", "boolean", "null"]
                }
              },
              "required": ["path", "operator", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["draft", "capability", "arguments", "comparison"],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
